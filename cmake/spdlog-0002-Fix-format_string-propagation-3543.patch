     template <typename... Args>
     void critical(wformat_string_t<Args...> fmt, Args &&...args) {
-#ifdef SPDLOG_USE_STD_FORMAT
         log(level::critical, fmt, std::forward<Args>(args)...);
-#else
-        log(level::critical, fmt.get(), std::forward<Args>(args)...);
-#endif
     }
