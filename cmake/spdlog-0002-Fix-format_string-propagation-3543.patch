     void info(wformat_string_t<Args...> fmt, Args &&...args) {
-#ifdef SPDLOG_USE_STD_FORMAT
         log(level::info, fmt, std::forward<Args>(args)...);
-#else
-        log(level::info, fmt.get(), std::forward<Args>(args)...);
-#endif
