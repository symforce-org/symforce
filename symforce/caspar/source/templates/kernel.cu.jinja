#include <cooperative_groups.h>
#include <cooperative_groups/details/partitioning.h>
#include <cooperative_groups/memcpy_async.h>
#include <cooperative_groups/reduce.h>
#include <cuda_runtime.h>

#include <stdexcept>
#include <string>

#include "kernel_{{kernel.name}}.h"
#include "memops.cuh"

namespace cg = cooperative_groups;

namespace caspar {

__global__ void
__launch_bounds__({{kernel.block_size}}, 1)
{{parts_to_pascal(kernel.name)}}Kernel(
    {% for accessor in kernel.accessors %}
    {% for name, typ in accessor.kernel_sig.items() %}
      {{typ}} {{name}},
    {% endfor %}
    {% endfor %}
    size_t problem_size) {
  {% if kernel.code_lines %}
  const int global_thread_idx = blockIdx.x * blockDim.x + threadIdx.x;
  {% if kernel.dynamic_shared_bytes > 0 %}
  // Scratch data, then the shared indices of each shared accessor; dynamic, so that it may exceed
  // the 48 KB static shared memory limit (see the launch below).
  extern __shared__ __align__(16) uint8_t inout_shared[];
  {% endif %}
  {% for idx_name, offset in kernel.shared_index_offsets.items() %}
  constexpr unsigned int {{idx_name}}_indices_shared_offset = {{offset}};
  {% endfor %}
  {% endif %}

  {% for accessor in kernel.accessors %}
  {% if kernel.code_lines %}
  {% filter indent(width=4) %}
    {{accessor.prep_lines}}
  {% endfilter %}
  {% endif %}
  {% if accessor.pre_calc_code() %}
  {{accessor.pre_calc_code()}}
  {% endif %}
  {% endfor %}

  {% if kernel.registers.__len__() > 0 %}
  {# Threads past problem_size pass these by value to accessor calls outside the guard without
     ever assigning them, so they need a defined value; zero is the identity of the sums. #}
  {{kernel.kernel_t}} {{' = 0, '.join(kernel.registers)}} = 0;
  {% endif %}

  if (global_thread_idx < problem_size){
  {% for code_line in kernel.code_lines %}
  {% filter indent(width=4) %}
    {{code_line}}
  {% endfilter %}
  {% endfor %}
  };
  {% for accessor in kernel.accessors %}
  {% if accessor.post_calc_code() %}
  {{accessor.post_calc_code()}}
  {% endif %}
  {% endfor %}
}


void {{parts_to_pascal(kernel.name)}} (
  {% for accessor in kernel.accessors %}
  {% for name, typ in accessor.kernel_sig.items() %}
  {{typ}} {{name}},
  {% endfor %}
  {% endfor %}
  size_t problem_size) {

  {% if kernel.outputs.__len__() == 0 %}
  return;
  {% else %}
  if (problem_size == 0) {
    return;
  }
  {% endif %}

  const int n_blocks = (problem_size + {{kernel.block_size}} - 1) / {{kernel.block_size}};
  {% for accessor in kernel.accessors %}
  {% if accessor.pre_kernel_code() %}
  {{accessor.pre_kernel_code()}}
  {% endif %}
  {% endfor %}
  {% if kernel.dynamic_shared_bytes > 0 %}
  // Kernels using more than 48 KB of shared memory per block must opt in.
  static const cudaError_t attribute_error = cudaFuncSetAttribute(
      {{parts_to_pascal(kernel.name)}}Kernel, cudaFuncAttributeMaxDynamicSharedMemorySize,
      {{kernel.dynamic_shared_bytes}});
  if (attribute_error != cudaSuccess) {
    throw std::runtime_error(std::string("{{parts_to_pascal(kernel.name)}}Kernel: ") +
                             cudaGetErrorString(attribute_error));
  }
  {% endif %}
  {{parts_to_pascal(kernel.name)}}Kernel<<<n_blocks, {{kernel.block_size}}, {{kernel.dynamic_shared_bytes}}>>>(
      {% for accessor in kernel.accessors %}
      {% for name in accessor.kernel_sig %}
      {{name}},
      {% endfor %}
      {% endfor %}
      problem_size
  );
  // A launch that fails (e.g. from exceeding shared memory or register limits) otherwise leaves its
  // outputs untouched without any error.
  const cudaError_t launch_error = cudaGetLastError();
  if (launch_error != cudaSuccess) {
    throw std::runtime_error(std::string("{{parts_to_pascal(kernel.name)}}Kernel launch failed: ") +
                             cudaGetErrorString(launch_error));
  }
}

}  // namespace caspar
